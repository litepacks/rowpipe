{
  "name": "rowpipe",
  "version": "2.10.5",
  "description": "Stream-first tabular data toolkit for CSV, TSV, JSON, JSONL, NDJSON, XLSX, Apache Parquet, Apache Arrow, Apache Avro, and XML",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "default": "./dist/core/index.js"
    },
    "./readers": {
      "types": "./dist/readers/index.d.ts",
      "import": "./dist/readers/index.js",
      "default": "./dist/readers/index.js"
    },
    "./writers": {
      "types": "./dist/writers/index.d.ts",
      "import": "./dist/writers/index.js",
      "default": "./dist/writers/index.js"
    },
    "./transforms": {
      "types": "./dist/transforms/index.d.ts",
      "import": "./dist/transforms/index.js",
      "default": "./dist/transforms/index.js"
    },
    "./analytics": {
      "types": "./dist/analytics/index.d.ts",
      "import": "./dist/analytics/index.js",
      "default": "./dist/analytics/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "import": "./dist/mcp/index.js",
      "default": "./dist/mcp/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "rowpipe": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "build:sea": "npm run build && npx -y yekpare build --strip",
    "release:sea": "npx -y yekpare release",
    "dev": "tsx src/cli/index.ts",
    "prepublishOnly": "npm run build && npm test",
    "test": "NODE_OPTIONS=\"--experimental-sqlite\" vitest run",
    "test:watch": "NODE_OPTIONS=\"--experimental-sqlite\" vitest",
    "test:formats": "NODE_OPTIONS=\"--experimental-sqlite\" vitest run tests/formats.test.ts tests/readers-writers.test.ts tests/compression.test.ts tests/ndjson.test.ts tests/arrow.test.ts tests/avro.test.ts tests/xml.test.ts",
    "test:fast": "NODE_OPTIONS=\"--experimental-sqlite\" vitest run tests/analytics.test.ts tests/clean.test.ts tests/transforms.test.ts tests/operations.test.ts tests/ndjson.test.ts tests/arrow.test.ts tests/avro.test.ts tests/xml.test.ts",
    "test:db": "NODE_OPTIONS=\"--experimental-sqlite\" vitest run tests/db.test.ts",
    "bench": "tsx benchmarks/memory-bench.ts",
    "benchmark:formats": "tsx benchmarks/new-formats-bench.ts",
    "benchmark:db": "tsx benchmarks/db-bench.ts",
    "benchmark:diff": "tsx benchmarks/diff-bench.ts",
    "benchmark:files": "tsx benchmarks/files-bench.ts",
    "benchmark:ops": "tsx benchmarks/operations-bench.ts",
    "benchmark:expr": "tsx benchmarks/expression-bench.ts"
  },
  "keywords": [
    "csv",
    "tsv",
    "json",
    "jsonl",
    "ndjson",
    "parquet",
    "arrow",
    "feather",
    "avro",
    "xml",
    "xlsx",
    "markdown",
    "streaming",
    "tabular",
    "data",
    "cli",
    "pipeline",
    "analytics"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@bokuweb/zstd-wasm": "^0.0.27",
    "apache-arrow": "^21.2.0",
    "avsc": "^5.7.9",
    "commander": "^13.1.0",
    "fzstd": "^0.1.1",
    "hyparquet": "^1.30.1",
    "hyparquet-compressors": "^1.1.1",
    "mcponce": "^0.2.3",
    "mysql2": "^3.24.4",
    "parquetjs-lite": "^0.8.7",
    "pg": "^8.23.0",
    "pg-query-stream": "^4.17.0",
    "read-excel-file": "^9.3.10",
    "sax": "^1.6.1",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/pg": "^8.23.1",
    "@types/sax": "^1.2.7",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7",
    "yekpare": "^0.1.1"
  }
}
